---
// Opens a page's screenshots full size on a click, and closes them on a click or Escape.
// The script adds every element it needs, so the built page holds each image once and
// the llms files made from it carry no second copy.
---

<script>
	const dialog = document.createElement('dialog');
	dialog.className = 'image-zoom';
	const enlarged = document.createElement('img');
	dialog.append(enlarged);
	dialog.addEventListener('click', () => dialog.close());
	document.body.append(dialog);

	for (const image of document.querySelectorAll<HTMLImageElement>('.sl-markdown-content img')) {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'image-zoom-trigger';
		button.setAttribute('aria-label', `Enlarge: ${image.alt}`);
		image.replaceWith(button);
		button.append(image);
		button.addEventListener('click', () => {
			enlarged.src = image.currentSrc || image.src;
			enlarged.alt = image.alt;
			dialog.showModal();
		});
	}
</script>

<style is:global>
	.image-zoom-trigger {
		display: block;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}
	.image-zoom {
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 1rem;
		border: 0;
		background: transparent;
		cursor: zoom-out;
	}
	.image-zoom[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.image-zoom::backdrop {
		background: rgb(0 0 0 / 0.85);
	}
	.image-zoom img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}
</style>
