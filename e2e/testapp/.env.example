# The auth server, as its discovery document names it.
GOIABADA_ISSUER=https://e2e-auth.goiabada.dev

# Where this app is reached. Every redirect URI is built from it.
APP_URL=http://localhost:3000

# Add sign-in to a web app: two confidential clients, the second for single sign-on.
WEB_CLIENT_ID=testapp-web
WEB_CLIENT_SECRET=
WEB2_CLIENT_ID=testapp-web2
WEB2_CLIENT_SECRET=

# Add sign-in to a SPA or mobile app: a public client, no secret.
SPA_CLIENT_ID=testapp-spa

# Protect an API: the service that calls it with the client credentials flow.
SERVICE_CLIENT_ID=testapp-service
SERVICE_CLIENT_SECRET=

# The API's resource in Goiabada, and the permission it checks.
API_RESOURCE=product-api
API_SCOPE=product-api:read

# Protect an API, "Ask the auth server about a token": the API's own client, which introspects.
API_CLIENT_ID=testapp-api
API_CLIENT_SECRET=
