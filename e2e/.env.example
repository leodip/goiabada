# Copy to e2e/.env (gitignored). A variable already set in the environment wins over this file.

# The VPS the environment runs on, reached over SSH with your own key.
E2E_VPS_HOST=
E2E_VPS_USER=root

# The four public names. Each needs an A record (and an AAAA record for IPv6) to the VPS, created
# before prepare.sh runs: it refuses to start otherwise.
E2E_AUTH_HOST=e2e-auth.goiabada.dev
E2E_ADMIN_HOST=e2e-admin.goiabada.dev
E2E_WEBTEST1_HOST=e2e-webtest1.goiabada.dev
E2E_WEBTEST2_HOST=e2e-webtest2.goiabada.dev

# What the setup wizard is given.
E2E_ADMIN_EMAIL=admin@goiabada.dev
E2E_DB=postgres

# On the VPS: the Compose project's directory, whose name is the project's, and the certificate's
# name in certbot.
E2E_REMOTE_DIR=/root/goiabada-e2e
E2E_CERT_NAME=e2e.goiabada.dev
