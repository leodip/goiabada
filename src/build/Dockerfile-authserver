FROM golang:1.27.3-alpine AS build

ARG version
ARG buildDate
ARG gitCommit

WORKDIR /app/src

# Create directories first
RUN mkdir -p /app/src/core /app/src/authserver

# Copy go.mod files into the directories
COPY ./core/go.mod /app/src/core/
COPY ./authserver/go.mod /app/src/authserver/

# Download dependencies for core
WORKDIR /app/src/core
RUN go mod download

# Download dependencies for authserver
WORKDIR /app/src/authserver
RUN go mod download


# Copy the rest of the source code
WORKDIR /app/src
COPY ./authserver ./authserver
COPY ./core ./core

RUN mkdir -p /app/bin

WORKDIR /app/src/authserver
# -w drops the DWARF debug data, which nothing in a deployment reads and which
# is about a third of this image compressed (#331). It is -w and not -s: -s
# would drop the symbol table too, which is what `govulncheck -mode=binary`
# matches at symbol level; without it the scan falls back to module level and
# reports vulnerabilities in packages the binary never calls. Panics and
# core/errs stacks keep function, file and line either way, because they come
# from the runtime's own tables, which -w leaves alone.
#
# No debuggable copy of a release is kept. To get one, build the release's tag
# with this file and the release's build arguments, after removing -w: the same
# commit, Go image and source path (/app/src, fixed above) give byte-identical
# code at identical addresses, so the rebuild's DWARF describes the shipped
# binary.
RUN go build -buildvcs=false -tags=production -ldflags="-w -X 'github.com/leodip/goiabada/core/buildinfo.Version=${version}' -X 'github.com/leodip/goiabada/core/buildinfo.BuildDate=${buildDate}' -X 'github.com/leodip/goiabada/core/buildinfo.GitCommit=${gitCommit}'" -o ../../bin/goiabada-authserver ./cmd/goiabada-authserver

# ------------------------------------------------------------------------------

FROM alpine:3.24 AS final

# The minor is pinned in src/authserver/versions.yaml as tools.alpine and written
# here by ./version-manager.sh update. A minor tag still receives Alpine's patch
# releases, so only the six-monthly minor bump is a step of its own (#396).

WORKDIR /app

# No zone database is installed: the binary embeds one (time/tzdata) and resolves
# TZ against it before its first record, so the base image needs no tzdata. CI's
# build validation starts this image with TZ set to prove it (#331).

# The final stage keeps eight Alpine packages and nothing else (#520): the base
# layout, keys and release files, BusyBox for the shell and the wget the
# healthchecks use, the CA bundle the server's TLS reads, and musl. The binary is
# static and does its own TLS, so the package manager, the OpenSSL and zlib it
# links, ssl_client and the other helpers go, and with them the advisories an
# image scanner reports in them. Without ssl_client, BusyBox's wget reaches
# http:// only. The upgrade first takes Alpine's fixes published since the alpine
# image was last built. The CA bundle is added before the delete because --purge
# would otherwise remove it as an orphaned dependency of apk-tools.
# TestReleaseDockerfiles_TheFinalStageHoldsTheEightPackages, in
# src/core/guard/release_final_stage_test.go, holds this instruction and the next to
# this form, and the list to the one build/smoke-test-images.sh checks CI's images
# against.
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates-bundle \
    && apk --no-cache --purge del apk-tools ssl_client scanelf musl-utils
# Checked in each platform's build of this stage: the release builds amd64 and arm64
# from one Dockerfile, and a build whose package database cannot be read, lists any
# other package or lacks one, or has no CA bundle stops here, so neither image can be
# pushed that way.
RUN [ -r /lib/apk/db/installed ] || { echo "unable to read the package database" >&2; exit 1; }; \
    packages="$(awk '/^P:/ { print substr($0, 3) }' /lib/apk/db/installed | sort | xargs)"; \
    expected="alpine-baselayout alpine-baselayout-data alpine-keys alpine-release busybox busybox-binsh ca-certificates-bundle musl"; \
    [ "$packages" = "$expected" ] || { echo "the final stage holds $packages, where it must hold exactly $expected" >&2; exit 1; }; \
    [ -f /etc/ssl/certs/ca-certificates.crt ] || { echo "the final stage has no /etc/ssl/certs/ca-certificates.crt" >&2; exit 1; }

# The server runs as uid and gid 10001, named goiabada, and never as root (#396).
# USER is numeric so a Kubernetes runAsNonRoot can verify it without reading
# /etc/passwd, and the docs tell an operator to make a mounted file readable to
# these ids. The binary is copied with no --chown, so it stays owned by root and
# writable by root alone, as /app is, and the process cannot replace what the next
# start runs. /data, where the generated Compose file mounts the
# SQLite volume, and /bootstrap, where the legacy bootstrap file is written, are
# created owned by 10001: Docker copies a mount point's ownership into an empty
# named volume, and creates a mount point the image lacks owned by root, where the
# server could write nothing.
RUN addgroup -S -g 10001 goiabada \
    && adduser -S -D -H -u 10001 -G goiabada goiabada \
    && mkdir /data /bootstrap \
    && chown 10001:10001 /data /bootstrap

COPY --from=build /app/bin/goiabada-authserver ./

USER 10001:10001

ENTRYPOINT ["/app/goiabada-authserver"]