# The build stage runs on the builder's platform and cross-compiles for the image's, which
# BuildKit passes as TARGETOS and TARGETARCH: a release builds linux/amd64 and linux/arm64
# from this file, and compiling the arm64 binary under emulation takes minutes longer for a
# byte-identical one (#808). TestReleaseBuilds_CrossCompile, in
# src/core/guard/release_build_rules_test.go, holds the build to this form.
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS build

ARG version
ARG buildDate
ARG gitCommit

WORKDIR /app/src

# Create directories first
RUN mkdir -p /app/src/core /app/src/authserver

# Copy go.mod files into the directories
COPY ./core/go.mod /app/src/core/
COPY ./authserver/go.mod /app/src/authserver/

# Download dependencies for core
WORKDIR /app/src/core
RUN go mod download

# Download dependencies for authserver
WORKDIR /app/src/authserver
RUN go mod download


# Copy the rest of the source code
WORKDIR /app/src
COPY ./authserver ./authserver
COPY ./core ./core

RUN mkdir -p /app/bin

# The folders the image holds besides the binary and the CA bundle, laid out here, owned and
# permitted as the image needs them, because the final stage has no shell to make them and takes
# each folder's owner and mode from the one COPY that creates it. /tmp is root's, world-writable and
# sticky, as on any Linux system: Go spills a large upload there, and Compose's tmpfs mounts over it.
# /data, where the generated Compose file mounts the SQLite volume, and /bootstrap, where the legacy
# bootstrap file is written, are owned by 10001: Docker copies a mount point's ownership into an
# empty named volume, and creates a mount point the image lacks owned by root, where the server
# could write nothing. TestReleaseDockerfiles_TheImagesAreScratch, in
# src/core/guard/release_final_stage_test.go, holds this instruction to this form.
RUN mkdir -p /app/rootfs/tmp /app/rootfs/data /app/rootfs/bootstrap \
    && chmod 1777 /app/rootfs/tmp \
    && chown 10001:10001 /app/rootfs/data /app/rootfs/bootstrap

WORKDIR /app/src/authserver
# Declared here, after the module downloads, so those layers are the same for every platform.
ARG TARGETOS
ARG TARGETARCH
# -w drops the DWARF debug data, which nothing in a deployment reads and which
# is about a third of this image compressed (#331). It is -w and not -s: -s
# would drop the symbol table too, which is what `govulncheck -mode=binary`
# matches at symbol level; without it the scan falls back to module level and
# reports vulnerabilities in packages the binary never calls. Panics and
# core/errs stacks keep function, file and line either way, because they come
# from the runtime's own tables, which -w leaves alone.
#
# No debuggable copy of a release is kept. To get one, build the release's tag
# with this file, the release's build arguments and the image's platform, after
# removing -w: the same commit, Go image, platform and source path (/app/src,
# fixed above) give byte-identical code at identical addresses, so the rebuild's
# DWARF describes the shipped binary.
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -buildvcs=false -tags=production -ldflags="-w -X 'github.com/leodip/goiabada/core/buildinfo.Version=${version}' -X 'github.com/leodip/goiabada/core/buildinfo.BuildDate=${buildDate}' -X 'github.com/leodip/goiabada/core/buildinfo.GitCommit=${gitCommit}'" -o ../../bin/goiabada-authserver ./cmd/goiabada-authserver

# ------------------------------------------------------------------------------

# The certificate refresh: the CA bundle the image ships, upgraded from a freshly fetched index of
# the Go image's own Alpine, so a release carries the newest ca-certificates-bundle when it is built
# rather than the one the Go image was built with. It runs on the builder's platform, since the
# bundle is the same text on every one. A refresh that cannot fetch the index fails the build
# rather than ship the image's bundle. --no-cache keeps no index on disk but does nothing against
# Docker's layer cache, so every release build, build-docker-images.sh and CI's build validation,
# passes --no-cache-filter certs and --no-cache-filter final: excluding this stage alone reruns it,
# but the final stage's COPY of its file is cached and ships an earlier build's bundle.
# TestReleaseBuilds_TheRealImageBuildsRerunTheRefresh, in
# src/core/guard/release_cache_filter_test.go, holds those builds to both.
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS certs
RUN apk upgrade --no-cache ca-certificates-bundle

# ------------------------------------------------------------------------------

# The image, on an empty base (#808). It holds the binary, the CA bundle the servers' TLS reads at
# the path Go reads first, where an operator's mount or SSL_CERT_FILE replaces it, and the folders
# laid out above, and nothing else: no shell, package manager or operating system package for an
# image scanner to report or a compromised process to run, and so no RUN here. It needs no zone
# database: the binary embeds one (time/tzdata) and resolves TZ against it before its first record,
# which CI's smoke run proves (#331). TestReleaseDockerfiles_TheImagesAreScratch, in
# src/core/guard/release_final_stage_test.go, holds this stage to these instructions, and
# build/smoke-test-images.sh holds each built image to the contents that test lists.
FROM scratch AS final

COPY --from=build /app/rootfs/ /
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# Copied with no --chown, so the binary and /app stay root's and writable by root alone, and the
# process cannot replace what the next start runs.
COPY --from=build /app/bin/goiabada-authserver /app/goiabada-authserver

WORKDIR /app

# The server runs as uid and gid 10001 and never as root (#396). USER is numeric so a Kubernetes
# runAsNonRoot can verify it without a passwd file, which the image has none of, and the docs tell
# an operator to make a mounted file readable to these ids.
USER 10001:10001

# The server's own check of its /health, which applies wherever a deployment sets no check of its
# own: a plain docker run, a Swarm service, a Compose service without one. The start period gives a
# first start's seed or an upgrade's migrations five minutes before a failure counts. No
# --start-interval: Docker 24's builders refuse the flag.
HEALTHCHECK --interval=10s --timeout=5s --start-period=300s --retries=3 CMD ["/app/goiabada-authserver", "healthcheck"]

ENTRYPOINT ["/app/goiabada-authserver"]
