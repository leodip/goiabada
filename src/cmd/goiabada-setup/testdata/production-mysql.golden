# Generated by goiabada-setup
# Run: docker compose up -d
# This file holds no secret: docker compose merges every one in from
# docker-compose.override.yml, beside it.

services:

  mysql-server:
    # A major, the one latest named when this file's generator was released. A major upgrade
    # is a dump and restore, not a tag edit: MySQL upgrades a data directory in place only
    # along its documented paths, and does not start on one it cannot.
    image: mysql:26
    restart: unless-stopped
    volumes:
      - mysql-data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -uroot -p\"$${MYSQL_ROOT_PASSWORD}\" --protocol tcp"]
      interval: 1s
      timeout: 2s
      retries: 20
    networks:
      - goiabada-network

  goiabada-authserver:
    image: leodip/goiabada:authserver-latest
    restart: unless-stopped
    # Up to 50s to stop cleanly (15s to drain requests, 15s for work handed off after
    # responses, 20s for the cleanup worker) plus 10s of headroom; Compose's default is 10s.
    stop_grace_period: 60s
    # Runs as the image's own uid and gid, 10001, with every capability dropped, no privilege
    # gained through a setuid binary, and a read-only root.
    # /tmp is a tmpfs, where SQLite writes the temporary files of large sorts and VACUUM, and
    # where Go spills an upload larger than it keeps in memory.
    user: "10001:10001"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    depends_on:
      mysql-server:
        condition: service_healthy
    ports:
      - 127.0.0.1:9090:9090
    networks:
      - goiabada-network
    healthcheck:
      test: ["CMD", "wget", "--spider", "http://localhost:9090/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      # Up to 5 minutes for a first start to seed the database, or an upgrade to migrate it;
      # failures in that window do not count, and the first success ends it.
      start_period: 300s
    environment:
      - "TZ=UTC"
      - "GOIABADA_ADMIN_EMAIL=admin@example.com"
      - "GOIABADA_APPNAME=Goiabada"
      - "GOIABADA_AUTHSERVER_BASEURL=https://auth.example.com"
      # Plain HTTP: the admin console's secret and tokens cross this hop unencrypted, so it assumes a network you trust.
      - "GOIABADA_AUTHSERVER_INTERNALBASEURL=http://goiabada-authserver:9090"
      - "GOIABADA_AUTHSERVER_LISTEN_HOST_HTTP=0.0.0.0"
      - "GOIABADA_AUTHSERVER_LISTEN_PORT_HTTP=9090"
      - "GOIABADA_AUTHSERVER_LISTEN_HOST_HTTPS="
      - "GOIABADA_AUTHSERVER_LISTEN_PORT_HTTPS="
      - "GOIABADA_AUTHSERVER_CERTFILE="
      - "GOIABADA_AUTHSERVER_KEYFILE="
      # The reverse proxy on this host, nginx or a Cloudflare Tunnel, appends the address it
      # received each connection from to X-Forwarded-For, so trusting one hop, the rightmost
      # entry, resolves the client with no list. Set the list only for a second proxy hop in
      # front of that one, naming every hop, this service's peer included: the Compose
      # network's gateway, not 127.0.0.1. For Cloudflare's proxy in front of nginx, have nginx
      # resolve Cloudflare instead, as
      # https://goiabada.dev/deploy/client-ip-and-proxy-trust/#cloudflare--nginx shows.
      - "GOIABADA_AUTHSERVER_TRUST_PROXY_HEADERS=true"
      - "GOIABADA_AUTHSERVER_TRUSTED_PROXIES="
      # The auth server's built-in rate limiter: per-IP limits on sign-in, password reset,
      # self-registration and client registration, and limits on failed passwords and codes per
      # account. The server's own default is off. The limits are listed at
      # https://goiabada.dev/reference/environment-variables/#rate-limits
      # With it on, the auth server logs a warning at every start that it trusts one proxy hop
      # with no list; behind the one reverse proxy on this host, that is expected.
      - "GOIABADA_AUTHSERVER_RATELIMITER_ENABLED=true"
      - "GOIABADA_AUTHSERVER_LOG_HTTP_REQUESTS=true"
      - "GOIABADA_AUTHSERVER_LOG_LEVEL=info"
      - "GOIABADA_AUTHSERVER_LOG_FORMAT=text"
      - "GOIABADA_AUTHSERVER_LOG_SQL=false"
      - "GOIABADA_AUTHSERVER_STATICDIR="
      - "GOIABADA_AUTHSERVER_TEMPLATEDIR="
      - "GOIABADA_AUTHSERVER_DEBUG_API_REQUESTS=false"
      - "GOIABADA_DB_TYPE=mysql"
      - "GOIABADA_DB_USERNAME=root"
      - "GOIABADA_DB_HOST=mysql-server"
      - "GOIABADA_DB_PORT=3306"
      - "GOIABADA_DB_NAME=goiabada"
      - "GOIABADA_ADMINCONSOLE_BASEURL=https://admin.example.com"

  goiabada-adminconsole:
    image: leodip/goiabada:adminconsole-latest
    restart: unless-stopped
    # The auth server's value: this service stops within its 15s drain, and a grace
    # period is a ceiling, not a wait. Compose's default is 10s.
    stop_grace_period: 60s
    # Runs as the image's own uid and gid, 10001, with every capability dropped, no privilege
    # gained through a setuid binary, and a read-only root.
    # /tmp is a tmpfs, where Go spills an upload larger than it keeps in memory.
    user: "10001:10001"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    depends_on:
      goiabada-authserver:
        condition: service_healthy
    ports:
      - 127.0.0.1:9091:9091
    networks:
      - goiabada-network
    environment:
      - "TZ=UTC"
      - "GOIABADA_ADMINCONSOLE_BASEURL=https://admin.example.com"
      - "GOIABADA_ADMINCONSOLE_LISTEN_HOST_HTTP=0.0.0.0"
      - "GOIABADA_ADMINCONSOLE_LISTEN_PORT_HTTP=9091"
      - "GOIABADA_ADMINCONSOLE_LISTEN_HOST_HTTPS="
      - "GOIABADA_ADMINCONSOLE_LISTEN_PORT_HTTPS="
      - "GOIABADA_ADMINCONSOLE_CERTFILE="
      - "GOIABADA_ADMINCONSOLE_KEYFILE="
      # The reverse proxy on this host, nginx or a Cloudflare Tunnel, appends the address it
      # received each connection from to X-Forwarded-For, so trusting one hop, the rightmost
      # entry, resolves the client with no list. Set the list only for a second proxy hop in
      # front of that one, naming every hop, this service's peer included: the Compose
      # network's gateway, not 127.0.0.1. For Cloudflare's proxy in front of nginx, have nginx
      # resolve Cloudflare instead, as
      # https://goiabada.dev/deploy/client-ip-and-proxy-trust/#cloudflare--nginx shows.
      - "GOIABADA_ADMINCONSOLE_TRUST_PROXY_HEADERS=true"
      - "GOIABADA_ADMINCONSOLE_TRUSTED_PROXIES="
      - "GOIABADA_ADMINCONSOLE_LOG_HTTP_REQUESTS=true"
      - "GOIABADA_ADMINCONSOLE_LOG_LEVEL=info"
      - "GOIABADA_ADMINCONSOLE_LOG_FORMAT=text"
      - "GOIABADA_ADMINCONSOLE_STATICDIR="
      - "GOIABADA_ADMINCONSOLE_TEMPLATEDIR="
      - "GOIABADA_AUTHSERVER_BASEURL=https://auth.example.com"
      # Plain HTTP: the admin console's secret and tokens cross this hop unencrypted, so it assumes a network you trust.
      - "GOIABADA_AUTHSERVER_INTERNALBASEURL=http://goiabada-authserver:9090"


volumes:
  mysql-data:

networks:
  goiabada-network:
