# Generated by goiabada-setup
# Environment file for native binary deployment
#
# Usage:
#   set -a && . ./goiabada.env && set +a && ./goiabada-authserver
#   set -a && . ./goiabada.env && set +a && ./goiabada-adminconsole
#
# Or with systemd, add EnvironmentFile=/path/to/goiabada.env
#
# IMPORTANT: The database must be empty for initial deployment.
# Goiabada will seed it with OAuth clients configured for the URLs below.

# =============================================================================
# Application settings
# =============================================================================
GOIABADA_APPNAME="Goiabada"
GOIABADA_ADMIN_EMAIL="admin@example.com"
GOIABADA_ADMIN_PASSWORD="admin-password"

# =============================================================================
# Database settings
# =============================================================================
GOIABADA_DB_TYPE="postgres"
GOIABADA_DB_HOST="goiabada-db"
GOIABADA_DB_PORT="5432"
GOIABADA_DB_NAME="goiabada"
GOIABADA_DB_USERNAME="goiabada-user"
GOIABADA_DB_PASSWORD="db-password"

# =============================================================================
# Auth server settings
# =============================================================================
GOIABADA_AUTHSERVER_BASEURL="https://auth.example.com"
# No reverse proxy fronts this server: it listens on every interface and trusts no
# forwarded header, so each client is the address it connects from. It serves plain HTTP
# until you set GOIABADA_AUTHSERVER_CERTFILE and GOIABADA_AUTHSERVER_KEYFILE, which turn
# on HTTPS at 0.0.0.0:9443 (GOIABADA_AUTHSERVER_LISTEN_HOST_HTTPS and _LISTEN_PORT_HTTPS
# change it); then set the HTTP listen host below empty to stop serving plain HTTP.
GOIABADA_AUTHSERVER_LISTEN_HOST_HTTP="0.0.0.0"
GOIABADA_AUTHSERVER_LISTEN_PORT_HTTP="9090"
GOIABADA_AUTHSERVER_TRUST_PROXY_HEADERS="false"
# The auth server's built-in rate limiter: per-IP limits on sign-in, password reset,
# self-registration and client registration, and limits on failed passwords and codes per
# account. The server's own default is off. The limits are listed at
# https://goiabada.dev/reference/environment-variables/#rate-limits
# With it on, the auth server logs a warning at every start that it trusts no forwarded
# header; with no reverse proxy in front, that is expected.
GOIABADA_AUTHSERVER_RATELIMITER_ENABLED="true"
GOIABADA_AUTHSERVER_SESSION_AUTHENTICATION_KEY="auth-session-auth-key"
GOIABADA_AUTHSERVER_SESSION_ENCRYPTION_KEY="auth-session-enc-key"
# GOIABADA_AES_ENCRYPTION_KEY encrypts the client secrets, SMTP credentials, OTP seeds and
# signing keys the database holds. Back it up separately from the database: without it they
# cannot be recovered, and a backup holding both gives them to whoever reads it.
GOIABADA_AES_ENCRYPTION_KEY="aes-encryption-key"
GOIABADA_AUTHSERVER_LOG_HTTP_REQUESTS="true"
GOIABADA_AUTHSERVER_LOG_LEVEL="info"
GOIABADA_AUTHSERVER_LOG_FORMAT="text"

# =============================================================================
# Admin console settings
# =============================================================================
GOIABADA_ADMINCONSOLE_BASEURL="https://admin.example.com"
# No reverse proxy fronts this server: it listens on every interface and trusts no
# forwarded header, so each client is the address it connects from. It serves plain HTTP
# until you set GOIABADA_ADMINCONSOLE_CERTFILE and GOIABADA_ADMINCONSOLE_KEYFILE, which turn
# on HTTPS at 0.0.0.0:9444 (GOIABADA_ADMINCONSOLE_LISTEN_HOST_HTTPS and _LISTEN_PORT_HTTPS
# change it); then set the HTTP listen host below empty to stop serving plain HTTP.
GOIABADA_ADMINCONSOLE_LISTEN_HOST_HTTP="0.0.0.0"
GOIABADA_ADMINCONSOLE_LISTEN_PORT_HTTP="9091"
GOIABADA_ADMINCONSOLE_TRUST_PROXY_HEADERS="false"
GOIABADA_ADMINCONSOLE_SESSION_AUTHENTICATION_KEY="admin-session-auth-key"
GOIABADA_ADMINCONSOLE_SESSION_ENCRYPTION_KEY="admin-session-enc-key"
GOIABADA_ADMINCONSOLE_LOG_HTTP_REQUESTS="true"
GOIABADA_ADMINCONSOLE_LOG_LEVEL="info"
GOIABADA_ADMINCONSOLE_LOG_FORMAT="text"

# =============================================================================
# OAuth client for admin console
# =============================================================================
GOIABADA_ADMINCONSOLE_OAUTH_CLIENT_SECRET="oauth-client-secret"
GOIABADA_AUTHSERVER_INTERNALBASEURL="https://auth.example.com"

