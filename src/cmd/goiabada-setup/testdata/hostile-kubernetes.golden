# Generated by goiabada-setup
# Apply with: kubectl apply -f goiabada-k8s.yaml
#
# IMPORTANT: The database must be empty for initial deployment.
# Goiabada will seed it with OAuth clients configured for the URLs below.
# If redeploying with different URLs, use a fresh database.

---
apiVersion: v1
kind: Namespace
metadata:
  name: "goiabada"

---
apiVersion: v1
kind: Secret
metadata:
  name: goiabada-secrets
  namespace: "goiabada"
type: Opaque
data:
  db-password: ZGI6ICJwdyIgIzEgJChpZCkgYHhgIFxuIA0Ke2E6IFtiXX0gMDEyMw==
  admin-password: cGEic3MnJEhPTUVgaWRgXHggI3k6IHoke0hPTUV9JCQKKi0gfiB5ZXMJ4oCoZW5kXA==
  auth-session-auth-key: YXV0aC1zZXNzaW9uLWF1dGgta2V5
  auth-session-enc-key: YXV0aC1zZXNzaW9uLWVuYy1rZXk=
  admin-session-auth-key: YWRtaW4tc2Vzc2lvbi1hdXRoLWtleQ==
  admin-session-enc-key: YWRtaW4tc2Vzc2lvbi1lbmMta2V5
  aes-encryption-key: YWVzLWVuY3J5cHRpb24ta2V5
  oauth-client-secret: b2F1dGgtY2xpZW50LXNlY3JldA==

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: goiabada-config
  namespace: "goiabada"
data:
  GOIABADA_APPNAME: "Goiabada"
  GOIABADA_ADMIN_EMAIL: "a\"b$c`d\\e #f'g@example.com"
  GOIABADA_AUTHSERVER_BASEURL: "https://auth.example.com/p\"a$HOME #x: y"
  GOIABADA_AUTHSERVER_INTERNALBASEURL: "http://goiabada-authserver:9090"
  GOIABADA_ADMINCONSOLE_BASEURL: "https://admin.example.com/`id`\\q'r ${PATH}"
  GOIABADA_AUTHSERVER_TRUST_PROXY_HEADERS: "true"
  GOIABADA_ADMINCONSOLE_TRUST_PROXY_HEADERS: "true"
  GOIABADA_DB_TYPE: "postgres"
  GOIABADA_DB_HOST: "goiabada-db"
  GOIABADA_DB_PORT: "5432"
  GOIABADA_DB_NAME: "goiabada"
  GOIABADA_DB_USERNAME: "us\"er\\na$me #x: '"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: goiabada-authserver
  namespace: "goiabada"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: goiabada-authserver
  template:
    metadata:
      labels:
        app: goiabada-authserver
    spec:
      # The most Kubernetes waits after deleting the pod before it kills the container: the
      # 5s preStop pause, plus up to 50s for the auth server to stop cleanly (15s to drain
      # requests, 15s for work handed off after responses, 20s for the cleanup worker),
      # plus 10s of headroom.
      # Set lower, it cuts the cleanup worker short first.
      terminationGracePeriodSeconds: 65
      containers:
      - name: authserver
        image: leodip/goiabada:authserver-latest
        ports:
        - containerPort: 9090
        envFrom:
        - configMapRef:
            name: goiabada-config
        env:
        - name: GOIABADA_ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-password
        - name: GOIABADA_DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: db-password
        - name: GOIABADA_AUTHSERVER_SESSION_AUTHENTICATION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-auth-key
        - name: GOIABADA_AUTHSERVER_SESSION_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-enc-key
        - name: GOIABADA_AES_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: aes-encryption-key
        - name: GOIABADA_ADMINCONSOLE_OAUTH_CLIENT_SECRET
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: oauth-client-secret
        livenessProbe:
          httpGet:
            path: /health
            port: 9090
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 9090
          initialDelaySeconds: 5
          periodSeconds: 5
        # Keep serving for a few seconds after the pod is deleted, while the gateway learns
        # it is gone: the server closes its listener the moment it is signalled, and a
        # connection the gateway opens before then would be refused.
        lifecycle:
          preStop:
            sleep:
              seconds: 5
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: goiabada-adminconsole
  namespace: "goiabada"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: goiabada-adminconsole
  template:
    metadata:
      labels:
        app: goiabada-adminconsole
    spec:
      # The most Kubernetes waits after deleting the pod before it kills the container: the
      # 5s preStop pause, plus up to 50s for the auth server to stop cleanly (15s to drain
      # requests, 15s for work handed off after responses, 20s for the cleanup worker),
      # plus 10s of headroom.
      # The auth server's value: this server stops within its 15s drain, and a grace period
      # is a ceiling, not a wait.
      terminationGracePeriodSeconds: 65
      containers:
      - name: adminconsole
        image: leodip/goiabada:adminconsole-latest
        ports:
        - containerPort: 9091
        envFrom:
        - configMapRef:
            name: goiabada-config
        env:
        - name: GOIABADA_ADMINCONSOLE_OAUTH_CLIENT_SECRET
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: oauth-client-secret
        - name: GOIABADA_ADMINCONSOLE_SESSION_AUTHENTICATION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-auth-key
        - name: GOIABADA_ADMINCONSOLE_SESSION_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-enc-key
        livenessProbe:
          httpGet:
            path: /health
            port: 9091
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 9091
          initialDelaySeconds: 5
          periodSeconds: 5
        # Keep serving for a few seconds after the pod is deleted, while the gateway learns
        # it is gone: the server closes its listener the moment it is signalled, and a
        # connection the gateway opens before then would be refused.
        lifecycle:
          preStop:
            sleep:
              seconds: 5
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"

---
apiVersion: v1
kind: Service
metadata:
  name: goiabada-authserver
  namespace: "goiabada"
spec:
  selector:
    app: goiabada-authserver
  ports:
  - port: 9090
    targetPort: 9090

---
apiVersion: v1
kind: Service
metadata:
  name: goiabada-adminconsole
  namespace: "goiabada"
spec:
  selector:
    app: goiabada-adminconsole
  ports:
  - port: 9091
    targetPort: 9091

---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: goiabada
  namespace: "goiabada"
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
spec:
  gatewayClassName: eg
  listeners:
  - name: http
    protocol: HTTP
    port: 80
  - name: auth-https
    protocol: HTTPS
    port: 443
    hostname: "auth.example.com"
    tls:
      mode: Terminate
      certificateRefs:
      - name: goiabada-tls-auth
  - name: admin-https
    protocol: HTTPS
    port: 443
    hostname: "admin.example.com"
    tls:
      mode: Terminate
      certificateRefs:
      - name: goiabada-tls-admin

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: goiabada-authserver
  namespace: "goiabada"
spec:
  parentRefs:
  - name: goiabada
    sectionName: auth-https
  hostnames:
  - "auth.example.com"
  rules:
  - backendRefs:
    - name: goiabada-authserver
      port: 9090

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: goiabada-adminconsole
  namespace: "goiabada"
spec:
  parentRefs:
  - name: goiabada
    sectionName: admin-https
  hostnames:
  - "admin.example.com"
  rules:
  - backendRefs:
    - name: goiabada-adminconsole
      port: 9091

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: goiabada-https-redirect
  namespace: "goiabada"
spec:
  parentRefs:
  - name: goiabada
    sectionName: http
  hostnames:
  - "auth.example.com"
  - "admin.example.com"
  rules:
  - filters:
    - type: RequestRedirect
      requestRedirect:
        scheme: https
        statusCode: 301
