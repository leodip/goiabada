# Generated by goiabada-setup
# The Secrets goiabada-k8s.yaml reads. Apply it before the manifest, so no pod starts with an
# older copy of them; it creates the namespace too:
#   kubectl apply -f goiabada-secrets.yaml -f goiabada-k8s.yaml
# base64 is an encoding, not encryption: anyone who can read this file reads every secret.
# Keep it out of version control, readable by its owner alone.

---
apiVersion: v1
kind: Namespace
metadata:
  name: "goiabada"
  # Pod Security admission warns on apply, and writes to the audit log, for any pod in this
  # namespace that breaks the restricted standard, and refuses none. If you own the namespace
  # outright, add pod-security.kubernetes.io/enforce: restricted to refuse such pods; check
  # first that everything else running here meets it, cert-manager's HTTP-01 solver pods
  # included, which run here while a certificate is issued.
  labels:
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted

---
apiVersion: v1
kind: Secret
metadata:
  name: goiabada-secrets
  namespace: "goiabada"
type: Opaque
data:
  db-password: ZGI6ICJwdyIgIzEgJChpZCkgYHhgIFxuIA0Ke2E6IFtiXX0gMDEyMw==
  admin-password: cGEic3MnJEhPTUVgaWRgXHggI3k6IHoke0hPTUV9JCQKKi0gfiB5ZXMJ4oCoZW5kXA==
  auth-session-auth-key: YXV0aC1zZXNzaW9uLWF1dGgta2V5
  auth-session-enc-key: YXV0aC1zZXNzaW9uLWVuYy1rZXk=
  admin-session-auth-key: YWRtaW4tc2Vzc2lvbi1hdXRoLWtleQ==
  admin-session-enc-key: YWRtaW4tc2Vzc2lvbi1lbmMta2V5
  oauth-client-secret: b2F1dGgtY2xpZW50LXNlY3JldA==

---
# GOIABADA_AES_ENCRYPTION_KEY encrypts the client secrets, SMTP credentials, OTP seeds and
# signing keys the database holds. Back it up separately from the database: without it they
# cannot be recovered, and a backup holding both gives them to whoever reads it.
# It is a Secret of its own so that RBAC can restrict get on it by resourceNames, and a
# secret manager can own it, apart from the other secrets. Read it back for the backup with:
#   kubectl get secret goiabada-encryption-key -n goiabada -o jsonpath='{.data.aes-encryption-key}' | base64 -d
apiVersion: v1
kind: Secret
metadata:
  name: goiabada-encryption-key
  namespace: "goiabada"
type: Opaque
data:
  aes-encryption-key: YWVzLWVuY3J5cHRpb24ta2V5
