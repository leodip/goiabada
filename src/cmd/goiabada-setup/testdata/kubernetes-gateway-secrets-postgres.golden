# Generated by goiabada-setup, from the answers in goiabada-setup.yaml, whose header says
# how to generate this file again.
# Apply with the Secrets file beside it, that file first, so no pod starts with an older
# copy of the Secrets; both files create the namespace:
#   kubectl apply -f goiabada-secrets.yaml -f goiabada-k8s.yaml
# This file holds no secret: every one is in goiabada-secrets.yaml.
#
# IMPORTANT: The database must be empty for initial deployment.
# Goiabada will seed it with OAuth clients configured for the URLs below.
# If redeploying with different URLs, use a fresh database.

---
apiVersion: v1
kind: Namespace
metadata:
  name: "goiabada"
  # Pod Security admission warns on apply, and writes to the audit log, for any pod in this
  # namespace that breaks the restricted standard, and refuses none. If you own the namespace
  # outright, add pod-security.kubernetes.io/enforce: restricted to refuse such pods; check
  # first that everything else running here meets it, cert-manager's HTTP-01 solver pods
  # included, which run here while a certificate is issued.
  labels:
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted

---
# What the auth server reads.
# The three URLs are in both ConfigMaps, written from the same answers; change them in both.
apiVersion: v1
kind: ConfigMap
metadata:
  name: goiabada-authserver-config
  namespace: "goiabada"
data:
  GOIABADA_AUTHSERVER_BASEURL: "https://auth.example.com"
  # Plain HTTP: the admin console's secret and tokens cross this hop unencrypted, so it assumes a network you trust.
  GOIABADA_AUTHSERVER_INTERNALBASEURL: "http://goiabada-authserver:9090"
  GOIABADA_ADMINCONSOLE_BASEURL: "https://admin.example.com"
  GOIABADA_APPNAME: "Goiabada"
  GOIABADA_ADMIN_EMAIL: "admin@example.com"
  # One hop trusted, the rightmost X-Forwarded-For entry, with no list: right behind a
  # routing layer that appends the address it received each connection from to the header,
  # as Envoy and Traefik do.
  # The servers then see the address each connection reached it from: the client's, or a
  # node's or a load balancer's for every client. Check the ip= of your own request in the
  # auth server's log once it runs.
  # Set the list only when a CDN or a second load balancer sits in front of the routing
  # layer, naming every hop, the routing layer's pods included.
  # A pod that calls the Service directly, around the routing layer, chooses the address
  # it is counted and audited under: a NetworkPolicy admitting only the routing layer
  # stops that, and no list does.
  GOIABADA_AUTHSERVER_TRUST_PROXY_HEADERS: "true"
  GOIABADA_AUTHSERVER_TRUSTED_PROXIES: ""
  # The auth server's rate limiter: per-IP limits on sign-in, password reset,
  # self-registration and client registration, and a limit on wrong passwords per email from
  # one network. The server's own default is off. Its limits per user (wrong one-time codes,
  # Account-page password checks, email verification codes and verification mails) and per
  # email (wrong passwords, password-reset mails and registration notices) apply either way.
  # The limits are listed at
  # https://goiabada.dev/reference/environment-variables/#rate-limits
  # The servers see the address each connection reached your routing layer from, which can
  # be a node's or a load balancer's, one for every client: the per-IP limits then count
  # every client together. Check the ip= of your own request in the auth server's log
  # before turning it on.
  # With it on, the auth server logs a warning at every start that it trusts one proxy hop
  # with no list; behind one routing layer, that is expected.
  GOIABADA_AUTHSERVER_RATELIMITER_ENABLED: "false"
  # One log record per request answered, as every other generated configuration writes.
  GOIABADA_AUTHSERVER_LOG_HTTP_REQUESTS: "true"
  GOIABADA_DB_TYPE: "postgres"
  GOIABADA_DB_HOST: "goiabada-db"
  GOIABADA_DB_PORT: "5432"
  GOIABADA_DB_NAME: "goiabada"
  GOIABADA_DB_USERNAME: "goiabada-user"
  # How the auth server protects its connection to the database: disable, prefer, require,
  # verify-ca or verify-full.
  # prefer: encrypted when the database offers TLS, plain text when it offers none; no certificate is checked.
  # Only verify-full makes sure it reached your database and nothing in between.
  GOIABADA_DB_TLS_MODE: "prefer"

---
# What the admin console reads.
# The three URLs are in both ConfigMaps, written from the same answers; change them in both.
apiVersion: v1
kind: ConfigMap
metadata:
  name: goiabada-adminconsole-config
  namespace: "goiabada"
data:
  GOIABADA_AUTHSERVER_BASEURL: "https://auth.example.com"
  # Plain HTTP: the admin console's secret and tokens cross this hop unencrypted, so it assumes a network you trust.
  GOIABADA_AUTHSERVER_INTERNALBASEURL: "http://goiabada-authserver:9090"
  GOIABADA_ADMINCONSOLE_BASEURL: "https://admin.example.com"
  # One hop trusted, the rightmost X-Forwarded-For entry, with no list: right behind a
  # routing layer that appends the address it received each connection from to the header,
  # as Envoy and Traefik do.
  # The servers then see the address each connection reached it from: the client's, or a
  # node's or a load balancer's for every client. Check the ip= of your own request in the
  # auth server's log once it runs.
  # Set the list only when a CDN or a second load balancer sits in front of the routing
  # layer, naming every hop, the routing layer's pods included.
  # A pod that calls the Service directly, around the routing layer, chooses the address
  # it is counted and audited under: a NetworkPolicy admitting only the routing layer
  # stops that, and no list does.
  GOIABADA_ADMINCONSOLE_TRUST_PROXY_HEADERS: "true"
  GOIABADA_ADMINCONSOLE_TRUSTED_PROXIES: ""
  # One log record per request answered, as every other generated configuration writes.
  GOIABADA_ADMINCONSOLE_LOG_HTTP_REQUESTS: "true"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: goiabada-authserver
  namespace: "goiabada"
spec:
  replicas: 1
  # A rollout starts one new pod and waits for it to be ready before it stops an old one, so
  # it never runs fewer pods than replicas.
  # The surge pod opens its own database connections: the docs' connection arithmetic counts it.
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app: goiabada-authserver
  template:
    metadata:
      labels:
        app: goiabada-authserver
      annotations:
        # The checksum of the ConfigMaps the pod reads, which it reads only when it starts: a
        # manifest whose ConfigMaps changed changes it, so applying the manifest rolls the pods.
        goiabada.dev/config-checksum: "d54587172c653fd2aa69126f6532e76bf51826be3ec2e173e084f32eacc45762"
    spec:
      # Neither server calls the Kubernetes API, so the pod mounts no service account token.
      automountServiceAccountToken: false
      # Kubernetes would otherwise give the container variables for every Service in the
      # namespace, GOIABADA_AUTHSERVER_PORT and GOIABADA_ADMINCONSOLE_SERVICE_HOST among them,
      # none of which either server reads.
      enableServiceLinks: false
      # The most Kubernetes waits after deleting the pod before it kills the container: the
      # 5s preStop pause, plus up to 50s for the auth server to stop cleanly (15s to drain
      # requests, 15s for work handed off after responses, 20s for the cleanup worker),
      # plus 10s of headroom.
      # Set lower, it cuts the cleanup worker short first.
      terminationGracePeriodSeconds: 65
      # Spread the pods over nodes, so losing or draining one takes as few as it can. Inert at
      # one replica; with more, a pod is still scheduled when the nodes cannot be balanced.
      topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: ScheduleAnyway
        labelSelector:
          matchLabels:
            app: goiabada-authserver
      containers:
      - name: authserver
        # Named in full: CRI-O, the runtime OpenShift uses, resolves a short name only through
        # registries its configuration lists, and may refuse to pull leodip/goiabada.
        image: docker.io/leodip/goiabada:authserver-latest
        # latest is a moving tag: each start pulls whatever release it names then, so pods can
        # run different releases. Replace it with a release version to pin the image.
        imagePullPolicy: Always
        # Everything the restricted Pod Security Standard requires, and a read-only root besides.
        # Neither server writes to its filesystem here: the legacy bootstrap file is unused under
        # Kubernetes, and the auth server's one other write, Go spilling an upload over the size
        # limit to /tmp, is refused as FILE_TOO_LARGE rather than by the image check, a 400 either
        # way. No writable mount is needed.
        # No user or group ID is set: the container runs as the image's user, uid and gid 10001.
        # OpenShift's restricted-v2 SCC, which refuses a user ID outside the namespace's range,
        # assigns one from that range instead.
        securityContext:
          runAsNonRoot: true
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
          seccompProfile:
            type: RuntimeDefault
        ports:
        - containerPort: 9090
        envFrom:
        - configMapRef:
            name: goiabada-authserver-config
        env:
        - name: GOIABADA_ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-password
        - name: GOIABADA_DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: db-password
        - name: GOIABADA_AUTHSERVER_SESSION_AUTHENTICATION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-auth-key
        - name: GOIABADA_AUTHSERVER_SESSION_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-enc-key
        - name: GOIABADA_AES_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-encryption-key
              key: aes-encryption-key
        - name: GOIABADA_ADMINCONSOLE_OAUTH_CLIENT_SECRET
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: oauth-client-secret
        # Read only while a key rotates, and optional: each is unset until its key is in the
        # Secret. A rotation adds and removes these keys and restarts the pods; nothing here
        # changes.
        - name: GOIABADA_AUTHSERVER_SESSION_AUTHENTICATION_KEY_PREVIOUS
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-auth-key-previous
              optional: true
        - name: GOIABADA_AUTHSERVER_SESSION_ENCRYPTION_KEY_PREVIOUS
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-enc-key-previous
              optional: true
        - name: GOIABADA_AES_ENCRYPTION_KEY_PREVIOUS
          valueFrom:
            secretKeyRef:
              name: goiabada-encryption-key
              key: aes-encryption-key-previous
              optional: true
        # Allows the container up to 5 minutes (60 failures, 5s apart) to start listening;
        # liveness and readiness wait for it, and its first success ends it.
        # The auth server opens the database, runs any outstanding migrations and seeds an
        # empty one before it listens; with several replicas, the first pod migrates and the
        # others wait for its lock. If an upgrade's migrations take longer, raise
        # failureThreshold until it times periodSeconds covers them, or the container is
        # restarted mid-migration.
        startupProbe:
          httpGet:
            path: /health
            port: 9090
          periodSeconds: 5
          timeoutSeconds: 1
          failureThreshold: 60
        # /health answers 200 whenever the process is up and touches neither the database nor
        # the auth server. Keep liveness on it: a check that follows a dependency would restart
        # every pod at once when that dependency has a short outage.
        livenessProbe:
          httpGet:
            path: /health
            port: 9090
          periodSeconds: 10
          timeoutSeconds: 1
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /health
            port: 9090
          periodSeconds: 5
          timeoutSeconds: 1
          failureThreshold: 3
        # Keep serving for a few seconds after the pod is deleted, while the gateway learns
        # it is gone: the server closes its listener the moment it is signalled, and a
        # connection the gateway opens before then would be refused.
        lifecycle:
          preStop:
            sleep:
              seconds: 5
        # A sign-in costs one bcrypt check at cost 10, about 35ms of CPU on a modern core, which no
        # limit slows on its own. At the 500m limit a pod verifies about 14 a second, and a burst
        # queues behind that: 16 at once take about 1.2s, and every other request on the pod waits
        # with them. Cloud cores are often slower than the one measured, and the 100m request is all
        # the scheduler guarantees on a busy node. For a higher sign-in peak, raise the limit or add
        # replicas.
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"

---
# A voluntary disruption, such as a node drain or a cluster upgrade, evicts one pod at a
# time. At one replica that pod is still evicted, and the server is down until its
# replacement is ready; at n replicas, n-1 keep serving.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: goiabada-authserver
  namespace: "goiabada"
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app: goiabada-authserver

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: goiabada-adminconsole
  namespace: "goiabada"
spec:
  replicas: 1
  # A rollout starts one new pod and waits for it to be ready before it stops an old one, so
  # it never runs fewer pods than replicas.
  # This server opens no database connections, so its surge pod costs the database nothing.
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app: goiabada-adminconsole
  template:
    metadata:
      labels:
        app: goiabada-adminconsole
      annotations:
        # The checksum of the ConfigMaps the pod reads, which it reads only when it starts: a
        # manifest whose ConfigMaps changed changes it, so applying the manifest rolls the pods.
        goiabada.dev/config-checksum: "20eeb74af8aefdcf615ba1e401426fb341e8aeac2a40e93d385e4054acf5f281"
    spec:
      # Neither server calls the Kubernetes API, so the pod mounts no service account token.
      automountServiceAccountToken: false
      # Kubernetes would otherwise give the container variables for every Service in the
      # namespace, GOIABADA_AUTHSERVER_PORT and GOIABADA_ADMINCONSOLE_SERVICE_HOST among them,
      # none of which either server reads.
      enableServiceLinks: false
      # The most Kubernetes waits after deleting the pod before it kills the container: the
      # 5s preStop pause, plus up to 50s for the auth server to stop cleanly (15s to drain
      # requests, 15s for work handed off after responses, 20s for the cleanup worker),
      # plus 10s of headroom.
      # The auth server's value: this server stops within its 15s drain, and a grace period
      # is a ceiling, not a wait.
      terminationGracePeriodSeconds: 65
      # Spread the pods over nodes, so losing or draining one takes as few as it can. Inert at
      # one replica; with more, a pod is still scheduled when the nodes cannot be balanced.
      topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: ScheduleAnyway
        labelSelector:
          matchLabels:
            app: goiabada-adminconsole
      containers:
      - name: adminconsole
        # Named in full: CRI-O, the runtime OpenShift uses, resolves a short name only through
        # registries its configuration lists, and may refuse to pull leodip/goiabada.
        image: docker.io/leodip/goiabada:adminconsole-latest
        # latest is a moving tag: each start pulls whatever release it names then, so pods can
        # run different releases. Replace it with a release version to pin the image.
        imagePullPolicy: Always
        # Everything the restricted Pod Security Standard requires, and a read-only root besides.
        # Neither server writes to its filesystem here: the legacy bootstrap file is unused under
        # Kubernetes, and the auth server's one other write, Go spilling an upload over the size
        # limit to /tmp, is refused as FILE_TOO_LARGE rather than by the image check, a 400 either
        # way. No writable mount is needed.
        # No user or group ID is set: the container runs as the image's user, uid and gid 10001.
        # OpenShift's restricted-v2 SCC, which refuses a user ID outside the namespace's range,
        # assigns one from that range instead.
        securityContext:
          runAsNonRoot: true
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
          seccompProfile:
            type: RuntimeDefault
        ports:
        - containerPort: 9091
        envFrom:
        - configMapRef:
            name: goiabada-adminconsole-config
        env:
        - name: GOIABADA_ADMINCONSOLE_OAUTH_CLIENT_SECRET
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: oauth-client-secret
        - name: GOIABADA_ADMINCONSOLE_SESSION_AUTHENTICATION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-auth-key
        - name: GOIABADA_ADMINCONSOLE_SESSION_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-enc-key
        # Read only while a key rotates, and optional: each is unset until its key is in the
        # Secret. A rotation adds and removes these keys and restarts the pods; nothing here
        # changes.
        - name: GOIABADA_ADMINCONSOLE_SESSION_AUTHENTICATION_KEY_PREVIOUS
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-auth-key-previous
              optional: true
        - name: GOIABADA_ADMINCONSOLE_SESSION_ENCRYPTION_KEY_PREVIOUS
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-enc-key-previous
              optional: true
        # Allows the container up to 5 minutes (60 failures, 5s apart) to start listening;
        # liveness and readiness wait for it, and its first success ends it.
        # The auth server's budget: this server listens once the auth server issues it a token,
        # which on a first start waits for the auth server to start, and then takes seconds.
        startupProbe:
          httpGet:
            path: /health
            port: 9091
          periodSeconds: 5
          timeoutSeconds: 1
          failureThreshold: 60
        # /health answers 200 whenever the process is up and touches neither the database nor
        # the auth server. Keep liveness on it: a check that follows a dependency would restart
        # every pod at once when that dependency has a short outage.
        livenessProbe:
          httpGet:
            path: /health
            port: 9091
          periodSeconds: 10
          timeoutSeconds: 1
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /health
            port: 9091
          periodSeconds: 5
          timeoutSeconds: 1
          failureThreshold: 3
        # Keep serving for a few seconds after the pod is deleted, while the gateway learns
        # it is gone: the server closes its listener the moment it is signalled, and a
        # connection the gateway opens before then would be refused.
        lifecycle:
          preStop:
            sleep:
              seconds: 5
        # The auth server's numbers. This server verifies no passwords and needs less.
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"

---
# A voluntary disruption, such as a node drain or a cluster upgrade, evicts one pod at a
# time. At one replica that pod is still evicted, and the server is down until its
# replacement is ready; at n replicas, n-1 keep serving.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: goiabada-adminconsole
  namespace: "goiabada"
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app: goiabada-adminconsole

---
apiVersion: v1
kind: Service
metadata:
  name: goiabada-authserver
  namespace: "goiabada"
spec:
  selector:
    app: goiabada-authserver
  ports:
  - port: 9090
    targetPort: 9090

---
apiVersion: v1
kind: Service
metadata:
  name: goiabada-adminconsole
  namespace: "goiabada"
spec:
  selector:
    app: goiabada-adminconsole
  ports:
  - port: 9091
    targetPort: 9091

---
# The certificates are the TLS Secrets each HTTPS listener names, which you supply in this
# namespace and renew before they expire.
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: goiabada
  namespace: "goiabada"
spec:
  gatewayClassName: "eg"
  listeners:
  - name: http
    protocol: HTTP
    port: 80
  - name: auth-https
    protocol: HTTPS
    port: 443
    hostname: "auth.example.com"
    tls:
      mode: Terminate
      certificateRefs:
      - name: "platform-tls"
  - name: admin-https
    protocol: HTTPS
    port: 443
    hostname: "admin.example.com"
    tls:
      mode: Terminate
      certificateRefs:
      - name: "platform-tls"

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: goiabada-authserver
  namespace: "goiabada"
spec:
  parentRefs:
  - name: "goiabada"
    sectionName: "auth-https"
  hostnames:
  - "auth.example.com"
  rules:
  - backendRefs:
    - name: goiabada-authserver
      port: 9090

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: goiabada-adminconsole
  namespace: "goiabada"
spec:
  parentRefs:
  - name: "goiabada"
    sectionName: "admin-https"
  hostnames:
  - "admin.example.com"
  rules:
  - backendRefs:
    - name: goiabada-adminconsole
      port: 9091

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: goiabada-https-redirect
  namespace: "goiabada"
spec:
  parentRefs:
  - name: goiabada
    sectionName: http
  hostnames:
  - "auth.example.com"
  - "admin.example.com"
  rules:
  - filters:
    - type: RequestRedirect
      requestRedirect:
        scheme: https
        statusCode: 301
