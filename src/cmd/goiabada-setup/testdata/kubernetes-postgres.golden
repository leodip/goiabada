# Generated by goiabada-setup
# Apply with: kubectl apply -f goiabada-k8s.yaml
#
# IMPORTANT: The database must be empty for initial deployment.
# Goiabada will seed it with OAuth clients configured for the URLs below.
# If redeploying with different URLs, use a fresh database.

---
apiVersion: v1
kind: Namespace
metadata:
  name: goiabada

---
apiVersion: v1
kind: Secret
metadata:
  name: goiabada-secrets
  namespace: goiabada
type: Opaque
data:
  db-password: ZGItcGFzc3dvcmQ=
  admin-password: YWRtaW4tcGFzc3dvcmQ=
  auth-session-auth-key: YXV0aC1zZXNzaW9uLWF1dGgta2V5
  auth-session-enc-key: YXV0aC1zZXNzaW9uLWVuYy1rZXk=
  admin-session-auth-key: YWRtaW4tc2Vzc2lvbi1hdXRoLWtleQ==
  admin-session-enc-key: YWRtaW4tc2Vzc2lvbi1lbmMta2V5
  aes-encryption-key: YWVzLWVuY3J5cHRpb24ta2V5
  oauth-client-secret: b2F1dGgtY2xpZW50LXNlY3JldA==

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: goiabada-config
  namespace: goiabada
data:
  GOIABADA_APPNAME: "Goiabada"
  GOIABADA_ADMIN_EMAIL: "admin@example.com"
  GOIABADA_AUTHSERVER_BASEURL: "https://auth.example.com"
  GOIABADA_AUTHSERVER_INTERNALBASEURL: "http://goiabada-authserver:9090"
  GOIABADA_ADMINCONSOLE_BASEURL: "https://admin.example.com"
  GOIABADA_AUTHSERVER_TRUST_PROXY_HEADERS: "true"
  GOIABADA_ADMINCONSOLE_TRUST_PROXY_HEADERS: "true"
  GOIABADA_DB_TYPE: "postgres"
  GOIABADA_DB_HOST: "goiabada-db"
  GOIABADA_DB_PORT: "5432"
  GOIABADA_DB_NAME: "goiabada"
  GOIABADA_DB_USERNAME: "goiabada-user"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: goiabada-authserver
  namespace: goiabada
spec:
  replicas: 1
  selector:
    matchLabels:
      app: goiabada-authserver
  template:
    metadata:
      labels:
        app: goiabada-authserver
    spec:
      containers:
      - name: authserver
        image: leodip/goiabada:authserver-latest
        ports:
        - containerPort: 9090
        envFrom:
        - configMapRef:
            name: goiabada-config
        env:
        - name: GOIABADA_ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-password
        - name: GOIABADA_DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: db-password
        - name: GOIABADA_AUTHSERVER_SESSION_AUTHENTICATION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-auth-key
        - name: GOIABADA_AUTHSERVER_SESSION_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: auth-session-enc-key
        - name: GOIABADA_AES_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: aes-encryption-key
        - name: GOIABADA_ADMINCONSOLE_OAUTH_CLIENT_SECRET
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: oauth-client-secret
        livenessProbe:
          httpGet:
            path: /health
            port: 9090
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 9090
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: goiabada-adminconsole
  namespace: goiabada
spec:
  replicas: 1
  selector:
    matchLabels:
      app: goiabada-adminconsole
  template:
    metadata:
      labels:
        app: goiabada-adminconsole
    spec:
      containers:
      - name: adminconsole
        image: leodip/goiabada:adminconsole-latest
        ports:
        - containerPort: 9091
        envFrom:
        - configMapRef:
            name: goiabada-config
        env:
        - name: GOIABADA_ADMINCONSOLE_OAUTH_CLIENT_SECRET
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: oauth-client-secret
        - name: GOIABADA_ADMINCONSOLE_SESSION_AUTHENTICATION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-auth-key
        - name: GOIABADA_ADMINCONSOLE_SESSION_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              name: goiabada-secrets
              key: admin-session-enc-key
        livenessProbe:
          httpGet:
            path: /health
            port: 9091
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 9091
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"

---
apiVersion: v1
kind: Service
metadata:
  name: goiabada-authserver
  namespace: goiabada
spec:
  selector:
    app: goiabada-authserver
  ports:
  - port: 9090
    targetPort: 9090

---
apiVersion: v1
kind: Service
metadata:
  name: goiabada-adminconsole
  namespace: goiabada
spec:
  selector:
    app: goiabada-adminconsole
  ports:
  - port: 9091
    targetPort: 9091

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: goiabada-authserver
  namespace: goiabada
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - auth.example.com
    secretName: goiabada-tls-auth
  rules:
  - host: auth.example.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: goiabada-authserver
            port:
              number: 9090

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: goiabada-adminconsole
  namespace: goiabada
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - admin.example.com
    secretName: goiabada-tls-admin
  rules:
  - host: admin.example.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: goiabada-adminconsole
            port:
              number: 9091
