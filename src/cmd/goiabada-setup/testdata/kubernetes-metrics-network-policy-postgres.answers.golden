# Generated by goiabada-setup: the answers goiabada-k8s.yaml was generated from.
# It holds no secret, and can be committed beside it.
#
# To generate goiabada-k8s.yaml again, from a new release of the wizard or a changed answer,
# leaving goiabada-secrets.yaml as it is, run the setup wizard from the directory holding
# them, with these flags:
#   --answers=goiabada-setup.yaml --keep-secrets
# A flag given beside --answers replaces the answer of its name.

version: 1
type: "kubernetes"
db: "postgres"
auth-url: "https://auth.example.com"
admin-url: "https://admin.example.com"
namespace: "goiabada"
create-namespace: true
routing: "envoy-gateway"
gateway-traffic-policy: "cluster"
network-policy: true
proxy-namespace: "envoy-gateway-system"
rate-limiter: false
metrics: "podmonitor"
podmonitor-labels: ""
metrics-namespace: "monitoring"
image-repository: "docker.io/leodip/goiabada"
image-digest: true
image-pull-secret: ""
labels: ""
annotations: ""
admin-email: "admin@example.com"
db-host: "goiabada-db"
db-port: "5432"
db-name: "goiabada"
db-user: "goiabada-user"
db-tls-mode: "prefer"
